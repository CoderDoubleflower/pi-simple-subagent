{
  "name": "pi-simple-subagent",
  "version": "0.2.0",
  "description": "Codex-style background subagents for Pi, with unified TUI settings and a renderer-neutral details protocol",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "subagent",
    "multi-agent"
  ],
  "author": "CoderDoubleflower",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "pi": {
    "extensions": [
      "./extensions/subagents.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "@types/node": "^22.19.19",
    "typebox": "^1.3.7",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CoderDoubleflower/pi-simple-subagent.git"
  },
  "homepage": "https://github.com/CoderDoubleflower/pi-simple-subagent#readme",
  "bugs": {
    "url": "https://github.com/CoderDoubleflower/pi-simple-subagent/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "examples",
    "README.md",
    "LICENSE",
    "pi-simple-subagent.schema.json"
  ]
}
